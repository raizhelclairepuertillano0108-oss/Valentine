<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Sweet Valentine Card</title>

  <!-- Open Graph / Twitter (edit image URL to your hosted preview) -->
  <meta property="og:title" content="A Sweet Valentine Card" />
  <meta property="og:description" content="Open a handcrafted Valentine card, add memories, and save map pins." />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://your-hosted-url/path/to/preview-image.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="A Sweet Valentine Card" />
  <meta name="twitter:description" content="Open a handcrafted Valentine card, add memories, and save map pins." />
  <meta name="twitter:image" content="https://your-hosted-url/path/to/preview-image.png" />

  <!-- Google font -->
  <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

  <!-- Leaflet CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-sA+N2gk1VJ3vHnM0vTJ3r3QqU5pI6bG6qv2X0KpR5vY=" crossorigin=""/>

  <style>
    :root{--bg:#fff5f8;--accent:#d84b70;--muted:#6b6b6b}
    html,body{height:100%;margin:0;font-family:'Inter',system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial;}
    body{background:linear-gradient(180deg,#fff 0%,#fff5f8 100%);color:#222;display:flex;flex-direction:column;min-height:100vh}
    header{padding:1rem 1.25rem;border-bottom:1px solid rgba(0,0,0,0.04);display:flex;align-items:center;gap:1rem}
    h1{font-family:'Libre Baskerville',serif;margin:0;font-weight:700;color:var(--accent)}
    main{flex:1;padding:1rem;display:grid;grid-template-columns:1fr 360px;gap:1rem}
    .panel{background:white;border-radius:10px;padding:12px;box-shadow:0 6px 18px rgba(0,0,0,0.06)}
    .controls{display:flex;flex-direction:column;gap:.5rem}
    .row{display:flex;gap:.5rem;align-items:center}
    button,select,input[type="date"]{padding:.45rem .6rem;border-radius:6px;border:1px solid rgba(0,0,0,0.08);background:white}
    #envelope{height:360px;background:linear-gradient(180deg,#ffeef4,#fff);border-radius:10px;overflow:hidden;position:relative;display:flex;align-items:center;justify-content:center}
    #envelope.closed #messageDisplay{transform:translateY(40px);opacity:0;pointer-events:none}
    #messageDisplay{min-height:120px;padding:1rem;border-radius:8px;background:rgba(255,255,255,0.8);width:85%;outline:2px dashed rgba(216,75,112,0.06);resize:none}
    #messageDisplay[contenteditable]{cursor:text}
    #gallery{display:flex;flex-wrap:wrap;gap:.5rem;max-height:220px;overflow:auto;padding:.25rem}
    #gallery img{width:64px;height:64px;border-radius:6px;object-fit:cover;cursor:pointer;border:2px solid transparent}
    #gallery img.main{outline:3px solid gold}
    #map{height:220px;border-radius:8px;border:1px solid rgba(0,0,0,0.06);overflow:hidden}
    .share-toolbar{display:flex;gap:.5rem;align-items:center;margin-top:8px}
    .muted{color:var(--muted);font-size:.9rem}
    canvas#hearts-canvas{position:fixed;left:0;top:0;pointer-events:none;z-index:0}
    /* simple responsive */
    @media (max-width:920px){ main{grid-template-columns:1fr; } }
  </style>
</head>
<body>
  <canvas id="hearts-canvas"></canvas>
  <header>
    <h1>Sweet Valentine</h1>
    <div class="muted">— craft a memory, seal it, and share the love</div>
  </header>

  <main>
    <section class="panel" aria-labelledby="card-label">
      <div class="row" style="justify-content:space-between">
        <div>
          <label class="muted">Music</label>
          <input id="musicToggle" type="checkbox" title="Play music" />
        </div>

        <div class="row">
          <label class="muted">Lock</label>
          <input id="lockToggle" type="checkbox" title="Lock Envelope" />
        </div>
      </div>

      <div id="envelope" class="closed" style="margin-top:1rem;z-index:1;position:relative">
        <div id="waxWrapper" style="position:absolute;right:14px;top:14px">
          <select id="waxSelect" aria-label="Wax seal">
            <option value="">No seal</option>
            <option value="wax-red.png">Red</option>
            <option value="wax-gold.png">Gold</option>
            <option value="wax-rose.png">Rose</option>
          </select>
          <img id="waxSeal" alt="wax" src="" style="width:42px;height:42px;display:block;margin-top:.4rem"/>
        </div>
        <div style="text-align:center;z-index:2">
          <div id="messageDisplay" contenteditable="true" aria-label="Personal message">Write your message here — or generate a poem.</div>
          <div style="margin-top:.5rem">
            <button id="openEnvelopeBtn" type="button">Toggle Envelope</button>
            <button id="generatePoemBtn" type="button">Generate Poem</button>
          </div>
        </div>
        <audio id="pianoAudio" preload="auto" style="display:none">
          <!-- Optional: add a piano audio file at piano.mp3 in repo root -->
          <!-- <source src="piano.mp3" type="audio/mpeg"> -->
        </audio>
      </div>

      <div style="display:flex;gap:.5rem;margin-top:.8rem;align-items:center;flex-wrap:wrap">
        <label class="muted">Floral</label>
        <select id="floralSelect">
          <option value="none">None</option>
          <option value="rose">Rose</option>
          <option value="lavender">Lavender</option>
          <option value="peony">Peony</option>
        </select>

        <label class="muted">Photos</label>
        <input id="photoInput" type="file" accept="image/*" multiple />

        <label class="muted">Target Date</label>
        <input id="targetDate" type="date" />
        <div class="muted" id="countdown">--</div>
      </div>

      <div id="gallery" style="margin-top:.6rem"></div>

      <div style="margin-top:.75rem;display:flex;justify-content:space-between;align-items:center">
        <div class="muted">Save map pins of memories below</div>
        <div>
          <button id="clearPinsBtn">Clear Pins</button>
        </div>
      </div>
    </section>

    <aside class="panel">
      <div style="display:flex;flex-direction:column;gap:.5rem">
        <div id="map" aria-label="Map"></div>
        <div class="share-toolbar" style="margin-top:.75rem">
          <button id="webShareBtn" type="button">Share</button>
          <a id="fbShare" target="_blank" rel="noopener noreferrer">Share on Facebook</a>
          <a id="twShare" target="_blank" rel="noopener noreferrer">Tweet</a>
          <button id="copyLinkBtn" type="button">Copy link</button>
          <span id="shareStatus" aria-live="polite" style="margin-left:.5rem;color:#666;font-size:.9rem"></span>
        </div>
      </div>
    </aside>
  </main>

  <footer style="padding:12px;text-align:center;font-size:.9rem;color:#666">
    <small>Hints: Use Ctrl/Cmd+Enter to quickly open the envelope. Add a preview image and enable GitHub Pages to share a link.</small>
  </footer>

  <!-- Leaflet JS -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-6gS0I3k9tq0Vb1Wm4q5N3Rk8hP1QkAZ6+q8V+P2zv1Y=" crossorigin=""></script>

  <!-- App script (merged from your single-file app) -->
  <script>
  // Simple Valentine Card single-file app logic
  // Assumes index.html loads this file and styles.css, plus Leaflet and Google fonts
  (() => {
    // --- Utilities & state ---
    const $ = id => document.getElementById(id);
    const piano = $('pianoAudio');
    const musicToggle = $('musicToggle');
    const openEnvelopeBtn = $('openEnvelopeBtn');
    const envelope = document.getElementById('envelope');
    const messageDisplay = $('messageDisplay');
    const waxSelect = $('waxSelect');
    const waxSealImg = $('waxSeal');
    const lockToggle = $('lockToggle');
    const photoInput = $('photoInput');
    const galleryEl = $('gallery');
    const floralSelect = $('floralSelect');
    const targetDateInput = $('targetDate');
    const countdownEl = $('countdown');
    const generatePoemBtn = $('generatePoemBtn');
    const mapEl = $('map');
    const clearPinsBtn = $('clearPinsBtn');
    const musicToggleEl = musicToggle;

    // persistent keys
    const LS = {
      message: 'valentine.message',
      gallery: 'valentine.gallery',
      wax: 'valentine.wax',
      floral: 'valentine.floral',
      targetDate: 'valentine.targetDate',
      pins: 'valentine.pins',
      locked: 'valentine.locked'
    };

    // --- Falling hearts canvas ---
    const canvas = document.getElementById('hearts-canvas');
    const ctx = canvas.getContext('2d');
    let hearts = [];
    function resizeCanvas(){ canvas.width = innerWidth; canvas.height = innerHeight; }
    window.addEventListener('resize', resizeCanvas); resizeCanvas();

    function rand(min,max){ return Math.random()*(max-min)+min }

    function createHeart(){
      const size = rand(10,30);
      return {
        x: rand(0, canvas.width),
        y: -rand(0, canvas.height*0.2),
        vy: rand(0.3,1.2),
        size,
        sway: rand(-0.3,0.3),
        hue: rand(330,360)
      }
    }
    for(let i=0;i<40;i++) hearts.push(createHeart());

    function drawHeart(x,y,size,hue){
      ctx.save();
      ctx.translate(x,y);
      ctx.scale(size/40,size/40);
      ctx.beginPath();
      ctx.moveTo(0, -12);
      ctx.bezierCurveTo(12,-32,40,-22,40,0);
      ctx.bezierCurveTo(40,28,5,42,0,60);
      ctx.bezierCurveTo(-5,42,-40,28,-40,0);
      ctx.bezierCurveTo(-40,-22,-12,-32,0,-12);
      ctx.closePath();
      ctx.fillStyle = `hsl(${hue} 90% 60% / 0.95)`;
      ctx.fill();
      ctx.restore();
    }

    function animate(){
      ctx.clearRect(0,0,canvas.width,canvas.height);
      for(let h of hearts){
        h.y += h.vy;
        h.x += Math.sin(h.y*0.02)*h.sway;
        drawHeart(h.x, h.y, h.size, h.hue);
        if(h.y > canvas.height + 60){
          Object.assign(h, createHeart());
          h.y = -rand(0,200);
        }
      }
      requestAnimationFrame(animate);
    }
    animate();

    // --- Music toggle ---
    musicToggle.addEventListener('change', e => {
      if(musicToggle.checked){
        try {
          piano.volume = 0.55;
          piano.play().catch(()=>{/* user gesture may be required */});
        } catch(e){}
      } else {
        piano.pause();
        piano.currentTime = 0;
      }
    });

    // --- Envelope open/close & locking ---
    function setWax(src){
      if(!src){ waxSealImg.src = ''; return; }
      waxSealImg.src = src;
      localStorage.setItem(LS.wax, src);
    }
    waxSelect.addEventListener('change', e => setWax(e.target.value));
    // load wax preference
    const savedWax = localStorage.getItem(LS.wax);
    if(savedWax) { waxSelect.value = savedWax; setWax(savedWax); }

    lockToggle.addEventListener('change', () => {
      localStorage.setItem(LS.locked, lockToggle.checked ? '1' : '');
      if(lockToggle.checked){
        envelope.classList.add('closed');
        envelope.classList.remove('open');
      }
    });

    openEnvelopeBtn.addEventListener('click', () => {
      if(lockToggle.checked) {
        alert("Envelope is locked with a wax seal. Uncheck 'Lock Envelope' to open.");
        return;
      }
      envelope.classList.toggle('open');
      envelope.classList.toggle('closed');
    });

    // --- Message persistence & poem generation ---
    function saveMessage(){ localStorage.setItem(LS.message, messageDisplay.innerText); }
    messageDisplay.addEventListener('input', saveMessage);
    const savedMsg = localStorage.getItem(LS.message);
    if(savedMsg) messageDisplay.innerText = savedMsg;

    const poems = [
      "In the hush of a rose-lit night, your name is my favorite sound.",
      "Two hearts, one path — every memory with you blossoms into forever.",
      "I found my home in the curve of your smile and the warmth of your hand.",
      "If stars were letters, I'd write you every sky and call it yours.",
      "You are the soft music that turns ordinary days into symphonies."
    ];
    generatePoemBtn.addEventListener('click', () => {
      const p = poems[Math.floor(Math.random()*poems.length)];
      messageDisplay.innerText = p;
      saveMessage();
      envelope.classList.add('open'); envelope.classList.remove('closed');
    });

    // --- Photo gallery upload & persistence ---
    function renderGallery(){
      galleryEl.innerHTML = '';
      const data = JSON.parse(localStorage.getItem(LS.gallery) || '[]');
      for(let i=0;i<data.length;i++){
        const item = data[i];
        const img = document.createElement('img');
        img.src = item;
        img.alt = 'memory';
        img.dataset.index = i;
        img.addEventListener('click', () => {
          // toggle selection as main
          const main = !img.classList.contains('main');
          document.querySelectorAll('#gallery img').forEach(im=>im.classList.remove('main'));
          if(main) img.classList.add('main');
        });
        galleryEl.appendChild(img);
      }
      // floral border
      const fb = localStorage.getItem(LS.floral) || 'none';
      galleryEl.className = 'gallery' + (fb === 'none' ? '' : ` flower-border-${fb}`);
    }

    photoInput.addEventListener('change', async (e) => {
      const files = Array.from(e.target.files || []);
      const stored = JSON.parse(localStorage.getItem(LS.gallery) || '[]');
      for(const f of files){
        const dataUrl = await fileToDataURL(f);
        stored.push(dataUrl);
      }
      localStorage.setItem(LS.gallery, JSON.stringify(stored));
      renderGallery();
      e.target.value = '';
    });

    function fileToDataURL(file){ return new Promise((res,rej)=>{
      const r = new FileReader();
      r.onload = ()=>res(r.result);
      r.onerror = rej;
      r.readAsDataURL(file);
    })}

    // floral selection persistence
    floralSelect.addEventListener('change', e => {
      const val = e.target.value === 'none' ? 'none' : e.target.value;
      localStorage.setItem(LS.floral, val);
      renderGallery();
    });
    const savedFloral = localStorage.getItem(LS.floral);
    if(savedFloral){ floralSelect.value = savedFloral; renderGallery(); }

    // load gallery
    renderGallery();

    // --- Countdown timer ---
    function updateCountdown(){
      const target = new Date(targetDateInput.value || localStorage.getItem(LS.targetDate) || new Date().toISOString().slice(0,10));
      localStorage.setItem(LS.targetDate, targetDateInput.value);
      const now = new Date();
      const diff = Math.max(0, target - now);
      const days = Math.floor(diff / (24*60*60*1000));
      const hours = Math.floor(diff / (60*60*1000) % 24);
      const mins = Math.floor(diff / (60*1000) % 60);
      const secs = Math.floor(diff / 1000 % 60);
      countdownEl.textContent = `${String(days).padStart(2,'0')}d ${String(hours).padStart(2,'0')}h ${String(mins).padStart(2,'0')}m ${String(secs).padStart(2,'0')}s`;
    }
    // init date input
    const savedDate = localStorage.getItem(LS.targetDate) || (() => {
      // default to next Feb 14 if current year passed
      const now = new Date(), year = (now.getMonth()>1 && now.getDate()>14) ? now.getFullYear()+1 : now.getFullYear();
      return `${year}-02-14`;
    })();
    targetDateInput.value = savedDate;
    setInterval(updateCountdown, 1000);
    updateCountdown();
    targetDateInput.addEventListener('change', () => { localStorage.setItem(LS.targetDate, targetDateInput.value); updateCountdown(); });

    // --- Map (Leaflet) with pin saving ---
    const map = L.map(mapEl, { attributionControl:true }).setView([20,0], 2);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);
    let pins = JSON.parse(localStorage.getItem(LS.pins) || '[]');

    function renderPins(){
      for(const layer of Object.values(map._layers || {})){
        if(layer?.options?.isPin) map.removeLayer(layer);
      }
      pins.forEach(p => {
        const m = L.marker([p.lat,p.lng], { title: p.note }).addTo(map);
        m.options.isPin = true;
        m.bindPopup(`<b>${p.note || 'Memory'}</b><br><small>${new Date(p.t).toLocaleString()}</small>`);
      });
    }
    renderPins();

    map.on('click', (e) => {
      const note = prompt('Name this memory/location:', '');
      if(note === null) return;
      const p = { lat: e.latlng.lat, lng: e.latlng.lng, note: note || 'Memory', t: Date.now() };
      pins.push(p);
      localStorage.setItem(LS.pins, JSON.stringify(pins));
      renderPins();
    });

    clearPinsBtn.addEventListener('click', () => {
      if(!confirm('Clear all map pins?')) return;
      pins = [];
      localStorage.removeItem(LS.pins);
      renderPins();
    });

    // --- load some saved toggles ---
    if(localStorage.getItem(LS.locked) === '1'){ lockToggle.checked = true; envelope.classList.add('closed'); }
    if(localStorage.getItem(LS.wax)){ waxSelect.value = localStorage.getItem(LS.wax); setWax(localStorage.getItem(LS.wax)); }
    if(localStorage.getItem(LS.floral)) { floralSelect.value = localStorage.getItem(LS.floral); }

    // small helper to allow keyboard-enter to open envelope
    document.addEventListener('keydown', e => {
      if(e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
        openEnvelopeBtn.click();
      }
    });

    // expose some debug to window
    window.__valentine = { renderGallery, pins, saveMessage };

  })();

  // --- Share toolbar script (uses current page URL) ---
  (function(){
    const fb = document.getElementById('fbShare');
    const tw = document.getElementById('twShare');
    const copyBtn = document.getElementById('copyLinkBtn');
    const webShareBtn = document.getElementById('webShareBtn');
    const status = document.getElementById('shareStatus');

    function updateShareLinks(){
      const url = encodeURIComponent(location.href);
      const text = encodeURIComponent(document.title || 'Valentine card — open this!');
      fb.href = `https://www.facebook.com/sharer/sharer.php?u=${url}&quote=${text}`;
      tw.href = `https://twitter.com/intent/tweet?text=${text}&url=${url}`;
    }

    async function copyLink(){
      try{
        await navigator.clipboard.writeText(location.href);
        status.textContent = 'Link copied!';
        setTimeout(()=> status.textContent = '', 2500);
      }catch(e){
        const dummy = window.prompt('Copy this link:', location.href);
        if(dummy) status.textContent = 'Link copied (manual)';
        setTimeout(()=> status.textContent = '', 2500);
      }
    }

    webShareBtn.addEventListener('click', async () => {
      if(navigator.share){
        try{
          await navigator.share({
            title: document.title || 'Valentine card',
            text: 'Check out this Valentine card!',
            url: location.href
          });
          status.textContent = 'Shared';
          setTimeout(()=> status.textContent = '', 2500);
        }catch(err){
          copyLink();
        }
      } else {
        copyLink();
      }
    });

    copyBtn.addEventListener('click', copyLink);
    updateShareLinks();
    // If your app updates the URL (pushState), call updateShareLinks() afterward.
    window.updateValentineShareLinks = updateShareLinks;
  })();
  </script>
</body>
</html>
